{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized barbershop administrator account",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "admin"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "active", "createdAt", "updatedAt"]
    },
    "BarbershopSettings": {
      "title": "BarbershopSettings",
      "description": "Public profile and scheduling rules for the barbershop",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "maxLength": 120 },
        "slogan": { "type": "string", "maxLength": 140 },
        "address": { "type": "string", "maxLength": 240 },
        "phone": { "type": "string", "maxLength": 32 },
        "whatsapp": { "type": "string", "maxLength": 32 },
        "minLeadMinutes": { "type": "number" },
        "slotIntervalMinutes": { "type": "number" },
        "cancellationMinHours": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shopName", "slogan", "address", "phone", "whatsapp", "minLeadMinutes", "slotIntervalMinutes", "cancellationMinHours", "updatedAt"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Barbershop service offering with price and duration",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 400 },
        "price": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "active": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "durationMinutes", "active", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Private customer profile keyed by normalized WhatsApp/phone",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "normalizedPhone": { "type": "string", "maxLength": 24, "pattern": "^[0-9]{10,15}$" },
        "firstVisitAt": { "type": "string", "maxLength": 40 },
        "lastVisitAt": { "type": "string", "maxLength": 40 },
        "totalVisits": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "normalizedPhone", "totalVisits", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Customer appointment with historical service and price snapshot",
      "type": "object",
      "properties": {
        "confirmationCode": { "type": "string", "maxLength": 24 },
        "serviceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceName": { "type": "string", "maxLength": 100 },
        "servicePrice": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "endTime": { "type": "string", "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "startMinutes": { "type": "number" },
        "endMinutes": { "type": "number" },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "normalizedPhone": { "type": "string", "maxLength": 24, "pattern": "^[0-9]{10,15}$" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "no_show"] },
        "source": { "type": "string", "enum": ["public", "admin"] },
        "notes": { "type": "string", "maxLength": 500 },
        "cancelHash": { "type": "string", "format": "byte", "maxLength": 64 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "confirmationCode",
        "serviceId",
        "serviceName",
        "servicePrice",
        "durationMinutes",
        "date",
        "startTime",
        "endTime",
        "startMinutes",
        "endMinutes",
        "customerName",
        "customerPhone",
        "normalizedPhone",
        "status",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "DaySchedule": {
      "title": "DaySchedule",
      "description": "Non-PII daily slot occupancy map used for atomic concurrency locking",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "bookings": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "bookings", "updatedAt"]
    },
    "BusinessHoursDay": {
      "title": "BusinessHoursDay",
      "description": "Weekly operating hours and break interval for a day of week (0-6)",
      "type": "object",
      "properties": {
        "dayOfWeek": { "type": "number" },
        "label": { "type": "string", "maxLength": 32 },
        "isOpen": { "type": "boolean" },
        "startTime": { "type": "string", "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "endTime": { "type": "string", "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "hasBreak": { "type": "boolean" },
        "breakStart": { "type": "string", "maxLength": 5 },
        "breakEnd": { "type": "string", "maxLength": 5 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dayOfWeek", "label", "isOpen", "startTime", "endTime", "hasBreak", "updatedAt"]
    },
    "BlockedPeriod": {
      "title": "BlockedPeriod",
      "description": "Day-off, holiday, vacation, or temporary time block",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["folga", "feriado", "ferias", "bloqueio"] },
        "startDate": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "endDate": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "allDay": { "type": "boolean" },
        "startTime": { "type": "string", "maxLength": 5 },
        "endTime": { "type": "string", "maxLength": 5 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "startDate", "endDate", "allDay", "createdAt", "updatedAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Confirmed financial revenue entry",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "serviceId": { "type": "string", "maxLength": 128 },
        "serviceName": { "type": "string", "maxLength": 100 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "appointmentId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "method": { "type": "string", "enum": ["dinheiro", "pix", "cartao_debito", "cartao_credito"] },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "serviceName", "customerName", "date", "method", "createdAt"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Barbershop operational expense entry",
      "type": "object",
      "properties": {
        "description": { "type": "string", "maxLength": 160 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 80 },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "category", "date", "createdAt"]
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "Administrative backup snapshot metadata and native archive map",
      "type": "object",
      "properties": {
        "label": { "type": "string", "maxLength": 120 },
        "createdBy": { "type": "string", "maxLength": 160 },
        "recordCounts": { "type": "object" },
        "payload": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["label", "createdBy", "recordCounts", "payload", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized barbershop administrator allowlist"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BarbershopSettings" },
      "description": "Public shop information and scheduling configuration"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Editable catalog of barbershop services and pricing"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Private customer records keyed by normalized phone"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private appointment records containing customer PII and service snapshots"
    },
    "/daySchedules/{dateId}": {
      "schema": { "$ref": "#/entities/DaySchedule" },
      "description": "Public non-PII daily slot occupancy map for concurrency locking"
    },
    "/businessHours/{dayId}": {
      "schema": { "$ref": "#/entities/BusinessHoursDay" },
      "description": "Operating hours and breaks per weekday (0-6)"
    },
    "/blockedPeriods/{blockId}": {
      "schema": { "$ref": "#/entities/BlockedPeriod" },
      "description": "Holidays, days off, vacations, and temporary schedule blocks"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Realized revenue payments"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseRecord" },
      "description": "Barbershop operational expenses"
    },
    "/backups/{backupId}": {
      "schema": { "$ref": "#/entities/BackupSnapshot" },
      "description": "Administrative remote backup snapshots"
    }
  }
}
